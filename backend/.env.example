# Dev-only: этот файл читается из текущей папки при `cargo run`.
# Установленный релиз хранит настройки в ~/.triad/config.env (`triad setup`, `triad key`, ⚙ в UI).
# Приоритет: переменные окружения → ./.env → ~/.triad/config.env → умолчания.

# ── OpenRouter ───────────────────────────────────────────────────────────────
# Без ключа сервер стартует в MOCK-режиме (встроенный фейковый LLM) — UI и
# пайплайн можно потрогать офлайн, но реплики будут шаблонными.
OPENROUTER_API_KEY=

# Модель для агентов (нужна поддержка assistant prefill: deepseek / claude / gemini / llama)
OPENROUTER_MODEL=deepseek/deepseek-chat
# Быстрая модель для скрытого LLM-Режиссёра (JSON). Если пусто — берётся OPENROUTER_MODEL.
OPENROUTER_DIRECTOR_MODEL=google/gemini-2.5-flash

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000
# По умолчанию ~/.triad/triad.db. Для dev можно держать рядом:
DATABASE_URL=sqlite://triad.db?mode=rwc
# UI встраивается в бинарник при сборке, если есть frontend/dist. Чтобы отдавать папку с диска
# (без пересборки) — укажи её явно:
# STATIC_DIR=../frontend/dist
# Разрешить менять ключ/модель через UI с чужих адресов (по умолчанию только localhost):
# ALLOW_REMOTE_SETTINGS=false
# Отключить проверку новых релизов при старте:
# TRIAD_NO_UPDATE_CHECK=1
# Публичный URL (уходит в заголовки OpenRouter HTTP-Referer / X-Title)
APP_URL=http://localhost:3000

# ── Brain layout ─────────────────────────────────────────────────────────────
# pipeline (по умолчанию): Reader → Caster → агенты → Картограф ∥ Психолог — маленькие запросы,
# слабые/бесплатные модели справляются. single — один большой запрос Режиссёра.
# DIRECTOR_MODE=pipeline
# pipeline: ход агента = мысль → реплика → пометка (3 маленьких вызова). single — один вызов с prefill.
# AGENT_MODE=pipeline
# Как агенты пользуются библиотекой: native — function calling (модель должна уметь tools),
# tags — действия тегами <act> в тексте, auto — native, если каталог OpenRouter говорит, что модель умеет.
# AGENT_TOOLS=auto
# Токен для внешних MCP-клиентов (POST /mcp). С localhost не требуется.
# MCP_TOKEN=

# ── Ты ──────────────────────────────────────────────────────────────────────
# Жители знают, с кем говорят (удобнее через мастер первого запуска в UI).
# PLAYER_NAME=Саша
# PLAYER_BIO=делаю свой продукт, хочу пинков и памяти
# Путь к git-клону для обновления из приложения (по умолчанию ищется от бинарника).
# TRIAD_REPO=

# ── Окна наружу (всё необязательно; удобнее через ⚙ в UI) ────────────────────
# Поиск: ddg без ключа (по умолчанию), tavily | brave (нужен SEARCH_API_KEY), searxng (SEARXNG_URL), off.
# SEARCH_PROVIDER=ddg
# SEARCH_API_KEY=
# SEARXNG_URL=
# Погода Open-Meteo по городу (без ключа) — строка «за окном» у Режиссёра и агентов.
# WEATHER_CITY=Москва
# Приватная .ics-ссылка твоего календаря (Google/Яндекс/Apple) — комната знает, что у тебя на неделе.
# CALENDAR_ICS_URL=
# Фильмы (TMDB v3). Книги (OpenLibrary) и Википедия работают без ключа.
# TMDB_API_KEY=
# GitHub: публичные репо без токена.
# GITHUB_TOKEN=
# Голос: пусто — голоса браузера. OpenAI-совместимые эндпоинты (OpenAI, Groq, локальные).
# TTS_URL=https://api.openai.com/v1/audio/speech
# TTS_API_KEY=
# TTS_MODEL=tts-1
# TTS_VOICES=physicist=onyx,lit_teacher=nova,graffiti=echo
# STT_URL=https://api.groq.com/openai/v1/audio/transcriptions
# STT_API_KEY=
# STT_MODEL=whisper-large-v3
# Как часто опрашивать объекты типа «Лента» (мин).
# FEEDS_EVERY_MIN=180
# Куда складывать вложения (по умолчанию ~/.triad/files).
# FILES_DIR=

# ── Life without you ─────────────────────────────────────────────────────────
# Через сколько минут твоего молчания комната начинает действовать сама (0 — выкл):
# кто-то пишет первым, двое спорят, кто-то двигает свой проект. Интервал удваивается,
# пока ты не вернёшься (до суток). Telegram-комнаты получают пуш от бота.
# HEARTBEAT_MINUTES=40
# Тихие часы по локальному времени сервера (комната молчит):
# QUIET_HOURS=23-08
# Потолок вызовов LLM в сутки на все комнаты (0 — без лимита). На free-tier держи ~200–400.
# DAILY_CALL_BUDGET=400
# Пульс в mock-режиме (для отладки):
# HEARTBEAT_IN_MOCK=false

# ── Room physics ─────────────────────────────────────────────────────────────
# Сколько последних сообщений видят Режиссёр и агенты
CONTEXT_MESSAGES=14
# Энтропия: сколько HP / дофамина теряет каждый живой агент за автономный тик
TICK_ENTROPY_HP=2
TICK_ENTROPY_DOPAMINE=3

RUST_LOG=info,sqlx=warn

# ── Telegram Mini App (публичный режим) ──────────────────────────────────────
# Токен бота от @BotFather. Когда задан: initData проверяется по HMAC, у каждого
# Telegram-пользователя своя комната (~/.triad/rooms/tg_<id>.db), снаружи без Telegram — 401.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF…
# Публичный https-URL мини-аппа (кнопка в /start). По умолчанию = APP_URL.
# WEBAPP_URL=https://triad.example.com
# Кто может менять ключ/модели прямо из мини-аппа (Telegram user id через запятую).
# TELEGRAM_ADMIN_IDS=123456789
# Отвечать на /start кнопкой «Открыть комнату» (long polling). Выключи, если бот живёт отдельно.
# TELEGRAM_POLLING=true
# Пускать браузеры без Telegram в общую комнату local даже в публичном режиме (для отладки).
# ALLOW_ANON_ROOMS=false
