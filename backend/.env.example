# ── OpenRouter ───────────────────────────────────────────────────────────────
# Без ключа сервер стартует в MOCK-режиме (встроенный фейковый LLM) — UI и
# пайплайн можно потрогать офлайн, но реплики будут шаблонными.
OPENROUTER_API_KEY=

# Модель для агентов (нужна поддержка assistant prefill: deepseek / claude / gemini / llama)
OPENROUTER_MODEL=deepseek/deepseek-chat
# Быстрая модель для скрытого LLM-Режиссёра (JSON). Если пусто — берётся OPENROUTER_MODEL.
OPENROUTER_DIRECTOR_MODEL=google/gemini-2.5-flash

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000
DATABASE_URL=sqlite://triad.db?mode=rwc
# Папка со сборкой фронтенда (npm run build). Если существует — отдаётся тем же бинарником.
STATIC_DIR=../frontend/dist
# Публичный URL (уходит в заголовки OpenRouter HTTP-Referer / X-Title)
APP_URL=http://localhost:3000

# ── Room physics ─────────────────────────────────────────────────────────────
# Сколько последних сообщений видят Режиссёр и агенты
CONTEXT_MESSAGES=14
# Энтропия: сколько HP / дофамина теряет каждый живой агент за автономный тик
TICK_ENTROPY_HP=2
TICK_ENTROPY_DOPAMINE=3

RUST_LOG=info,sqlx=warn
