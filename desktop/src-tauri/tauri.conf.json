{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Triad Canvas",
  "version": "0.12.0",
  "identifier": "io.triadcanvas.desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Triad Canvas",
        "url": "index.html",
        "width": 1280,
        "height": 860,
        "minWidth": 420,
        "minHeight": 640,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Киберпсихологическая комната трёх ИИ-субъектов",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"]
      }
    }
  }
}
